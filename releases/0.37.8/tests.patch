diff --git a/tests/test-ability-ranges.py b/tests/test-ability-ranges.py
new file mode 100644
--- /dev/null
+++ b/tests/test-ability-ranges.py
@@ -0,0 +1,110 @@
+"""Exercise armed retail command mode with the actual assembled DLC effects."""
+from pathlib import Path
+import os
+import unittest
+from lupa.lua51 import LuaRuntime
+
+BASE = Path(__file__).resolve().parents[1]
+HUD = Path(os.environ.get('S2R_NATIVE', BASE/'payload/resources/native'))/'hud'
+DATA = BASE/'build/dlc-construction-costs.lua'
+
+class MobilityRanges(unittest.TestCase):
+    def setUp(self):
+        lua = self.lua = LuaRuntime(unpack_returned_tuples=True)
+        lua.execute("""
+modules={}
+function module(code)local e=setmetatable({},{__index=_G});local f=assert(loadstring(code));setfenv(f,e);f();return e end
+function import(path)return assert(modules[path],path)end
+function Vector(x,y,z)return {x,y,z}end
+function GetFocusArmy()return 1 end
+function GetGameTimeSeconds()return 10 end
+function GetTextureDimensions()return 256,256 end
+function ReforgedIsObserving()return observing==true end
+function GetRolloverInfo(id)
+ if id=='RF:Overlays'then return true,nativeCount or 0,false end
+ if id=='RF:Overlay'then return true,18,29,0,9,1,1,1,1,0 end
+end
+function GetUnitCommandData(units)return units[1].orders end
+function ParseEntityCategory(expression)return expression end
+function EntityCategoryContains(expression,id)
+ return expression==id or expression=='CYBRAN COMMAND -ESCAPEPOD' and id=='ucl0001'
+  or expression=='ILLUMINATE COMMAND -ESCAPEPOD' and id=='uil0001'
+end
+draws={}
+local function decal()
+ local d={}
+ function d:SetTexture(value)self.texture=value end
+ function d:SetScale(value)self.scale=value end
+ function d:SetPosition(value)self.position=value end
+ function d:Destroy()self.destroyed=true end
+ draws[#draws+1]=d
+ return d
+end
+modules['/lua/user/UserDecal.lua']={UserDecal=decal}
+function unit(id,bp,orders,army,x)
+ return {GetEntityId=function()return id end,GetBlueprint=function()return bp end,
+  GetPosition=function()return {x,2,400}end,GetArmy=function()return army end,orders=orders}
+end
+cybran=unit('17',{BlueprintId='ucl0001',General={JumpRange=70}},{'RULEUCC_Move','RULEUCC_Jump'},1,100)
+illuminate=unit('18',{BlueprintId='uil0001',General={TeleportRange=70}},{'RULEUCC_Teleport'},1,300)
+locked=unit('19',{BlueprintId='ucl0001',General={JumpRange=70}},{'RULEUCC_Move'},1,200)
+other=unit('20',{BlueprintId='ucl0001',General={JumpRange=70}},{'RULEUCC_Jump'},2,250)
+function sample(command,selection)
+ local kind=ability.Targeting(command and 'order',command and {name=command})
+ local all,coverage=ranges:Rings(selection,nil,false,command~=nil,nil,kind)
+ local rings={}
+ for _,ring in ipairs(all)do if ring.kind=='ability'then rings[#rings+1]=ring end end
+ return rings,coverage,all
+end
+""")
+        g = lua.globals()
+        g.modules['/lua/ui/game/reforged_construction_costs.lua'] = g.module(DATA.read_text())
+        for name in ['geometry','unitinfo','research_effects','ability_ranges','ranges']:
+            g.modules['/lua/ui/game/reforged_'+name+'.lua'] = g.module((HUD/('reforged_'+name+'.lua')).read_text())
+        lua.execute("""
+ability=import('/lua/ui/game/reforged_ability_ranges.lua')
+ranges=import('/lua/ui/game/reforged_ranges.lua').Create()
+""")
+
+    def test_live_command_uses_unit_origin_and_ignores_cursor_overlay(self):
+        self.lua.execute("""
+nativeCount=1
+local rings,coverage,all=sample('RULEUCC_Jump',{cybran,locked,other})
+assert(#rings==1 and #all==2 and all[2].kind=='overlay')
+assert(coverage.abilityCount==1 and coverage.abilityRadius==70)
+assert(rings[1].center[1]==100 and rings[1].center[3]==400 and rings[1].radius==70)
+assert(ranges:DrawAbilityFill(rings)==1 and draws[1].position[1]==100)
+local teleport=sample('RULEUCC_Teleport',{illuminate,cybran})
+assert(#teleport==1 and teleport[1].center[1]==300 and teleport[1].radius==70)
+assert(ranges:DrawAbilityFill(teleport)==1 and draws[1].position[1]==300)
+local canceled=sample(nil,{cybran})
+assert(#canceled==0 and ranges:DrawAbilityFill(canceled)==0 and draws[1].scale[1]==0)
+local move=sample('RULEUCC_Move',{cybran})
+assert(#move==0)
+""")
+
+    def test_native_completed_research_and_scoped_dlc_modifiers(self):
+        self.lua.execute("""
+local ids={CCB_JUMPJETDISTANCE=7,ICB_TELEPORTDISTANCE=9}
+function GetResearchId(id)return ids[id]or -1 end
+function IsCompletedResearch(id)return done==id end
+done=7
+assert(sample('RULEUCC_Jump',{cybran})[1].radius==210)
+assert(sample('RULEUCC_Teleport',{illuminate})[1].radius==70)
+done=9
+assert(sample('RULEUCC_Jump',{cybran})[1].radius==70)
+assert(sample('RULEUCC_Teleport',{illuminate})[1].radius==140)
+""")
+
+    def test_focused_research_sample_and_observer_guard(self):
+        self.lua.execute("""
+function ReforgedObserverSnapshot()
+ return {focus=1,time=10,armies={[1]={research={CCB_JUMPJETDISTANCE=1}}}}
+end
+assert(sample('Jump',{cybran})[1].radius==210)
+observing=true
+assert(#sample('Jump',{cybran})==0)
+""")
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
