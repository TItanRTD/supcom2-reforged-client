--- /dev/null
+++ b/payload/resources/native/hud/reforged_ability_ranges.lua
@@ -0,0 +1,53 @@
+local Data=import('/lua/ui/game/reforged_construction_costs.lua')
+local Effects=import('/lua/ui/game/reforged_research_effects.lua')
+local Info=import('/lua/ui/game/reforged_unitinfo.lua')
+local G=import('/lua/ui/game/reforged_geometry.lua')
+local names={RULEUCC_Jump='jump',Jump='jump',RULEUCC_Teleport='teleport',Teleport='teleport'}
+local specs={
+    jump={name='RULEUCC_Jump',short='Jump',field='JumpRange'},
+    teleport={name='RULEUCC_Teleport',short='Teleport',field='TeleportRange'},
+}
+local techIDs={}
+function Targeting(command,data)
+    if command=='order'and type(data)=='table'then return names[data.name]end
+end
+function Prepare(kind,sample)
+    local spec=specs[kind]
+    if not spec then return end
+    local definitions=(Data.MobilityRanges or{})[kind]or{}
+    local completed={}
+    for tech in pairs(definitions)do
+        local done
+        if type(GetResearchId)=='function'and type(IsCompletedResearch)=='function'then
+            if techIDs[tech]==nil then
+                local ok,id=pcall(GetResearchId,tech)
+                techIDs[tech]=ok and type(id)=='number'and id>=0 and id or false
+            end
+            if techIDs[tech]then
+                local ok,result=pcall(IsCompletedResearch,techIDs[tech])
+                if ok and type(result)=='boolean'then done=result end
+            end
+        end
+        if done==true or done==nil and sample and sample[tech]then completed[tech]=true end
+    end
+    return {spec=spec,definitions=definitions,completed=completed,radii={}}
+end
+function Radius(aim,unit)
+    local orders=GetUnitCommandData({unit})
+    if type(orders)~='table'then return end
+    local eligible=false
+    for _,order in pairs(orders)do
+        if order==aim.spec.name or order==aim.spec.short then eligible=true;break end
+    end
+    if not eligible then return end
+    local bp=Info.Blueprint(unit)
+    local id=bp and bp.BlueprintId
+    if not id then return end
+    if aim.radii[id]~=nil then return aim.radii[id]end
+    local base=(bp.General or{})[aim.spec.field]
+    if not G.Finite(base)or base<=0 then return end
+    local radius=Effects.Value(base,Effects.Active(aim.definitions,aim.completed,id),'range')
+    if not G.Finite(radius)or radius<=0 or radius>100000 then return end
+    aim.radii[id]=radius
+    return radius
+end
