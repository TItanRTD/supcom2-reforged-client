new file mode 100644
--- /dev/null
+++ b/payload/resources/native/hud/reforged_research_effects.lua
@@ -0,0 +1,39 @@
+-- Apply the retail research buff calculation to UI previews.
+local parsed={}
+function Matches(expression,unitID)
+    if parsed[expression]==nil then
+        local ok,filter=pcall(ParseEntityCategory,expression)
+        parsed[expression]=ok and filter or false
+    end
+    local filter=parsed[expression]
+    return filter and EntityCategoryContains(filter,unitID)
+end
+function Active(definitions,completed,unitID)
+    local active={}
+    for id in pairs(completed)do
+        for _,buff in ipairs(definitions[id]or{})do
+            if Matches(buff.category,unitID)then
+                local previous=active[buff.id]
+                active[buff.id]={definition=buff,count=buff.stacks=='ALWAYS' and previous and previous.count+1 or 1}
+            end
+        end
+    end
+    return active
+end
+function Value(base,buffs,key)
+    local add,mult,floor,ceil=0,1
+    for _,buff in pairs(buffs)do
+        local effect=buff.definition[key]
+        if effect then
+            local count=buff.count
+            add=add+(effect.Add or 0)*count
+            mult=mult+(effect.Mult or 0)*count
+            if effect.Floor then floor=math.min(floor or effect.Floor,effect.Floor)end
+            if effect.Ceil then ceil=math.max(ceil or effect.Ceil,effect.Ceil)end
+        end
+    end
+    local value=(base+add)*math.max(0,mult)
+    if floor then value=math.max(floor,value)end
+    if ceil then value=math.min(ceil,value)end
+    return math.max(0,value)
+end
