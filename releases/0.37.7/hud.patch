diff --git a/payload/resources/native/hud/reforged_buildcost.lua b/payload/resources/native/hud/reforged_buildcost.lua
new file mode 100644
--- /dev/null
+++ b/payload/resources/native/hud/reforged_buildcost.lua
@@ -0,0 +1,86 @@
+-- Read-only prices from the effective native research definitions and the
+-- focused army's existing research sample. The engine still charges the order.
+local Data=import('/lua/ui/game/reforged_construction_costs.lua')
+local Observer=import('/lua/ui/game/reforged_observer.lua')
+local parsed={}
+local function category(expression)
+    if parsed[expression]==nil then
+        local ok,filter=pcall(ParseEntityCategory,expression)
+        parsed[expression]=ok and filter or false
+    end
+    return parsed[expression]
+end
+local function matches(expression,id)
+    local filter=category(expression)
+    return filter and EntityCategoryContains(filter,id)
+end
+local function multiplier(base,buffs,key)
+    local add,mult,floor,ceil=0,1
+    for _,buff in pairs(buffs)do
+        local effect=buff[key]
+        if effect then
+            local count=buff.count
+            add=add+(effect.Add or 0)*count
+            mult=mult+(effect.Mult or 0)*count
+            if effect.Floor then floor=math.min(floor or effect.Floor,effect.Floor)end
+            if effect.Ceil then ceil=math.max(ceil or effect.Ceil,effect.Ceil)end
+        end
+    end
+    local value=(base+add)*math.max(0,mult)
+    if floor then value=math.max(floor,value)end
+    if ceil then value=math.min(ceil,value)end
+    return math.max(0,value)
+end
+local function factors(bp,target,completed)
+    local economy=bp.Economy or {}
+    local exclusion=economy.BuildModifiersExclusionCategory or bp.BuildModifiersExclusionCategory
+    if type(exclusion)=='table'then
+        for _,expression in pairs(exclusion)do
+            if type(expression)=='string'and matches(expression,target)then return 1,1 end
+        end
+    end
+    local active={}
+    for id in pairs(completed)do
+        for _,buff in ipairs(Data.ConstructionCosts[id]or{})do
+            if matches(buff.category,bp.BlueprintId)then
+                local previous=active[buff.id]
+                active[buff.id]={mass=buff.mass,energy=buff.energy,count=buff.stacks=='ALWAYS' and previous and previous.count+1 or 1}
+            end
+        end
+    end
+    return multiplier(economy.BuildMassCostMultiplier or 1,active,'mass'),
+        multiplier(economy.BuildEnergyCostMultiplier or 1,active,'energy')
+end
+local function label(base,low,high)
+    if type(base)~='number'then return '?'end
+    local function display(value)return (string.gsub(string.format('%.2f',value),'%.?0+$',''))end
+    local first,last=display(base*(low or 1)),display(base*(high or 1))
+    return first==last and first or first..'–'..last
+end
+function Labels(item)
+    local economy=item.bp.Economy or {}
+    local mass,energy=economy.MassValue or economy.BuildCostMass,economy.EnergyValue or economy.BuildCostEnergy
+    if not Data.ConstructionCosts then return label(mass),label(energy)end
+    local focus=GetFocusArmy()
+    local sample=Observer.Samples()[focus]
+    local completed=sample and sample.research or {}
+    local builders=GetSelectedUnits()or{}
+    local mMin,mMax,eMin,eMax
+    local seen={}
+    for _,unit in pairs(builders)do
+        if unit:GetArmy()==focus then
+            local bp=unit:GetBlueprint()
+            local id=bp.BlueprintId
+            if id and not seen[id]then
+                local _,_,buildable=GetUnitCommandData({unit})
+                if buildable and EntityCategoryContains(buildable,item.id)then
+                    seen[id]=true
+                    local m,e=factors(bp,item.id,completed)
+                    mMin,mMax=math.min(mMin or m,m),math.max(mMax or m,m)
+                    eMin,eMax=math.min(eMin or e,e),math.max(eMax or e,e)
+                end
+            end
+        end
+    end
+    return label(mass,mMin,mMax),label(energy,eMin,eMax)
+end
