--- /dev/null
+++ b/payload/resources/native/hud/overlays-x86.s
@@ -0,0 +1,354 @@
+.intel_syntax noprefix
+.code32
+.global overlay_entry
+/* Read-only collection of the retail placement/normal overlay instances.
+ * Existing native extractors retain blueprint, army, recon and interpolation
+ * decisions. Only a scoped append to OUR empty temporary vector is intercepted.
+ * Empty vectors make the retail placement draw return before any GPU operation.
+ * No orders, simulation writes, source-vector writes or persistent entity refs.
+ * Private RW space: 1d94030..3f metadata, 1d94040..49ff 64 x 36-byte records.
+ */
+.equ CONTEXT,0x01d94030
+.equ COUNT,0x01d94034
+.equ COLOR,0x01d94038
+.equ FOCUS,0x01d9403c
+.equ RECORDS,0x01d94040
+overlay_entry:
+ push ebp
+ push ebx
+ push esi
+ push edi
+ sub esp,512
+ mov eax,dword ptr [esp+532]
+ mov ebp,dword ptr [eax+0x7c]
+ mov ebx,dword ptr [ebp+0x1c]
+ mov ecx,dword ptr [ebx+0x24]
+ mov eax,dword ptr [ebx+0x20]
+ sub eax,ecx
+ cmp eax,8
+ jb fallback
+ cmp dword ptr [ecx],4
+ jne fallback
+ push 1
+ push ebx
+ mov eax,0x0041b060
+ call eax
+ add esp,8
+ test eax,eax
+ jz fallback
+ cmp dword ptr [eax],0x4f3a4652 /* RF:O */
+ jne fallback
+ cmp dword ptr [eax+4],0x6c726576 /* verl */
+ jne fallback
+ cmp word ptr [eax+8],0x7961 /* ay */
+ jne fallback
+ cmp byte ptr [eax+10],0
+ je read_record
+ cmp word ptr [eax+10],0x0073 /* s\0 : collect */
+ jne fallback
+ mov dword ptr [CONTEXT],0
+ mov dword ptr [COUNT],0
+ mov ebx,dword ptr [0x018ca63c]
+ test ebx,ebx
+ jz no_data
+ mov eax,dword ptr [ebx+0x4c0]
+ test eax,eax
+ js no_data
+ cmp eax,64
+ jae no_data
+ mov ecx,dword ptr [ebx+0x408]
+ test ecx,ecx
+ jz no_data
+ lea edx,[ecx+eax*4+4]
+ cmp edx,dword ptr [ebx+0x40c]
+ ja no_data
+ cmp dword ptr [ecx+eax*4],0
+ je no_data
+ mov dword ptr [FOCUS],eax
+ mov edi,dword ptr [0x018ca588]
+ test edi,edi
+ jz no_data
+ add edi,0x1a0
+ cmp dword ptr [edi+8],0
+ je no_data
+ /* Use the exact native active-filter synchronization, even while ren_Ranges
+  * is suppressed by the custom renderer. No GPU state is involved here. */
+ lea eax,[ebx+0x534]
+ push eax
+ push edi
+ mov eax,0x009f17e0
+ call eax
+ xor eax,eax
+ mov dword ptr [esp],eax
+ mov dword ptr [esp+4],eax
+ mov dword ptr [esp+8],eax
+ mov dword ptr [esp+12],eax
+ mov dword ptr [CONTEXT],esp
+ /* Placement uses native command descriptor, actual pending blueprint,
+  * preview coordinates and the original extractor/category predicates. */
+ cmp byte ptr [0x01526906],0
+ je normal_filters
+ push 0
+ push 0
+ lea eax,[esp+8]
+ push eax
+ push edi
+ mov ecx,ebx
+ mov eax,0x009f1d60
+ call eax
+normal_filters:
+ cmp byte ptr [ebx+0x4f4],0
+ je normal_start
+ mov eax,ebx
+ mov ecx,esp
+ push esi
+ mov esi,edi
+ mov edx,0x009f1fa0
+ call edx
+ pop esi
+normal_start:
+ mov esi,dword ptr [edi+0x14]
+ cmp esi,dword ptr [edi+0x18]
+ je collected
+ /* Retail entity-query container, including its initial stack allocation. */
+ lea eax,[esp+32]
+ mov dword ptr [esp+16],eax
+ mov dword ptr [esp+20],eax
+ lea edx,[esp+432]
+ mov dword ptr [esp+24],edx
+ mov dword ptr [esp+28],eax
+ push 0x100
+ lea eax,[ebx+0x68]
+ push eax
+ lea eax,[esp+24]
+ mov edx,0x00534de0
+ call edx
+filter_loop:
+ /* Match the retail normal pass's AllIntel/WaypointAbility exclusions. */
+ push 7
+ push 0x1354dec
+ push dword ptr [esi+0x14]
+ push 0
+ mov ecx,esi
+ mov eax,0x0040f600
+ call eax
+ test eax,eax
+ jz next_filter
+ push 15
+ push 0x1394eb8
+ push dword ptr [esi+0x14]
+ push 0
+ mov ecx,esi
+ mov eax,0x0040f600
+ call eax
+ test eax,eax
+ jz next_filter
+ lea eax,[esi+0x48]
+ mov dword ptr [COLOR],eax
+ lea eax,[esp]
+ push eax
+ push esi
+ push dword ptr [0x018c98b0]
+ lea eax,[esp+28]
+ push eax
+ mov eax,0x009f2060
+ call eax
+next_filter:
+ add esi,0x90
+ cmp esi,dword ptr [edi+0x18]
+ jne filter_loop
+ mov eax,dword ptr [esp+16]
+ cmp eax,dword ptr [esp+28]
+ je collected
+ push eax
+ mov eax,0x00efe003
+ call eax
+ add esp,4
+collected:
+ mov dword ptr [CONTEXT],0
+ mov ecx,dword ptr [ebp+0x1c]
+ mov edx,dword ptr [ecx+0x20]
+ mov dword ptr [edx],1
+ mov dword ptr [edx+4],1
+ mov dword ptr [edx+8],3
+ cvtsi2ss xmm0,dword ptr [COUNT]
+ movss dword ptr [edx+12],xmm0
+ mov dword ptr [edx+16],1
+ movzx eax,byte ptr [0x015268b1]
+ mov dword ptr [edx+20],eax
+ add edx,24
+ mov dword ptr [ecx+0x20],edx
+ mov eax,3
+ jmp done
+read_record:
+ mov ecx,dword ptr [ebp+0x1c]
+ mov eax,dword ptr [ecx+0x20]
+ sub eax,dword ptr [ecx+0x24]
+ cmp eax,16
+ jb no_data
+ mov eax,dword ptr [ecx+0x24]
+ cmp dword ptr [eax+8],4
+ jne no_data
+ push 2
+ push ecx
+ mov eax,0x0041b060
+ call eax
+ add esp,8
+ test eax,eax
+ jz no_data
+ xor ecx,ecx
+ xor edx,edx
+parse:
+ movzx ebx,byte ptr [eax+ecx]
+ test ebx,ebx
+ jz parsed
+ sub ebx,48
+ cmp ebx,9
+ ja no_data
+ imul edx,edx,10
+ add edx,ebx
+ inc ecx
+ cmp ecx,2
+ ja no_data
+ jmp parse
+parsed:
+ test edx,edx
+ jz no_data
+ cmp edx,64
+ ja no_data
+ cmp edx,dword ptr [COUNT]
+ ja no_data
+ mov eax,dword ptr [0x018ca63c]
+ test eax,eax
+ jz no_data
+ mov eax,dword ptr [eax+0x4c0]
+ cmp eax,dword ptr [FOCUS]
+ jne no_data
+ dec edx
+ imul edx,edx,36
+ lea esi,[edx+RECORDS]
+ mov ecx,dword ptr [ebp+0x1c]
+ mov edx,dword ptr [ecx+0x20]
+ mov dword ptr [edx],1
+ mov dword ptr [edx+4],1
+ add edx,8
+ mov edi,9
+emit:
+ mov dword ptr [edx],3
+ mov eax,dword ptr [esi]
+ mov dword ptr [edx+4],eax
+ add esi,4
+ add edx,8
+ dec edi
+ jnz emit
+ mov dword ptr [ecx+0x20],edx
+ mov eax,10
+ jmp done
+no_data:
+ mov ecx,dword ptr [ebp+0x1c]
+ mov edx,dword ptr [ecx+0x20]
+ mov dword ptr [edx],0
+ add edx,8
+ mov dword ptr [ecx+0x20],edx
+ mov eax,1
+done:
+ add esp,512
+ pop edi
+ pop esi
+ pop ebx
+ pop ebp
+ ret
+fallback:
+ add esp,512
+ pop edi
+ pop esi
+ pop ebx
+ pop ebp
+ push 0x01da6c00
+ ret
+
+.org 0x400,0x90
+.global overlay_append
+overlay_append:
+ cmp dword ptr [CONTEXT],edi
+ jne original_append
+ cmp dword ptr [esp],0x009f1ebd
+ je capture_build
+ cmp dword ptr [esp],0x009f200a
+ je capture_ability
+ cmp dword ptr [esp],0x009f2197
+ jne original_append
+ pushfd
+ pushad
+ mov esi,dword ptr [COLOR]
+ jmp capture
+capture_build:
+ pushfd
+ pushad
+ lea esi,[ebx+0x48]
+ jmp capture
+capture_ability:
+ pushfd
+ pushad
+ mov esi,dword ptr [0x018ca63c]
+ add esi,0x4fc
+capture:
+ mov ecx,dword ptr [COUNT]
+ cmp ecx,64
+ jae captured
+ imul edi,ecx,36
+ add edi,RECORDS
+ movups xmm0,xmmword ptr [edx]
+ movups xmmword ptr [edi],xmm0
+ movups xmm0,xmmword ptr [esi]
+ movups xmmword ptr [edi+16],xmm0
+ /* Classify by the exact retail extractor vtable, never a guessed BP range. */
+ /* WaypointAbility is a native targeting range, distinct from generic
+  * overlays. It must survive Lua's separate command-mode preview filter. */
+ mov edx,5
+ cmp dword ptr [esp+36],0x009f200a
+ je classified
+ xor edx,edx
+ cmp dword ptr [esp+36],0x009f1ebd
+ je build_filter
+ mov eax,dword ptr [COLOR]
+ sub eax,0x48
+ jmp identify
+build_filter:
+ mov eax,ebx
+identify:
+ mov edx,0x009f0100
+ push edi
+ call edx
+ pop edi
+ xor edx,edx
+ test eax,eax
+ jz classified
+ mov eax,dword ptr [eax]
+ mov edx,1
+ cmp eax,0x1394f68
+ je classified
+ inc edx
+ cmp eax,0x1394fb8
+ je classified
+ inc edx
+ cmp eax,0x1394fc8
+ je classified
+ inc edx
+ cmp eax,0x1394fa8
+ je classified
+ xor edx,edx
+classified:
+ cvtsi2ss xmm0,edx
+ movss dword ptr [edi+32],xmm0
+ inc dword ptr [COUNT]
+captured:
+ popad
+ popfd
+ ret
+original_append:
+ push ecx
+ mov ecx,dword ptr [edi+4]
+ push ebx
+ push 0x009f3245
+ ret
