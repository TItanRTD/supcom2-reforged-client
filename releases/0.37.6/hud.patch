diff --git a/payload/resources/native/hud/scoreboard-badges-x86.s b/payload/resources/native/hud/scoreboard-badges-x86.s
new file mode 100644
--- /dev/null
+++ b/payload/resources/native/hud/scoreboard-badges-x86.s
@@ -0,0 +1,30 @@
+.intel_syntax noprefix
+.code32
+.text
+.global append_scoreboard_badges
+.equ ratings, 0x01d90ea0
+.equ badges, 0x01d90ef8
+
+# The original bridge already pushed five results. EAX is either null or
+# the matched rating address for one of eight exact player names. The sixth
+# result is a packed pair of icon IDs, present only when a badge exists.
+append_scoreboard_badges:
+    test eax, eax
+    jz no_badges
+    sub eax, ratings
+    shr eax, 2
+    movzx eax, byte ptr [eax+badges]
+    test eax, eax
+    jz no_badges
+    cvtsi2ss xmm0, eax
+    mov dword ptr [edx], 3
+    movss dword ptr [edx+4], xmm0
+    add edx, 8
+    mov dword ptr [ecx+0x20], edx
+    pop esi
+    mov eax, 6
+    ret
+no_badges:
+    pop esi
+    mov eax, 5
+    ret
