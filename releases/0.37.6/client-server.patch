+"use strict";
+
+function isRecordedSlot(value) {
+    return Number.isInteger(value) && value >= 0 && value < 8;
+}
+
+function isBadgeCode(value) {
+    if (!Number.isInteger(value) || value < 1 || value > 0xc7)
+        return false;
+    const experience = value & 15;
+    const recognition = value >>> 4;
+    return experience <= 7 && (recognition === 0 || recognition >= 8);
+}
+
+function playerDisplayFields(player) {
+    return {
+        ...(isRecordedSlot(player.startPosition) ? { startPosition: player.startPosition } : {}),
+        ...(Number.isFinite(player.rating) && Math.abs(player.rating) <= 1000000 ? { rating: player.rating } : {}),
+        ...(isBadgeCode(player.badgeCode) ? { badgeCode: player.badgeCode } : {}),
+    };
+}
+
+// Native scoreboard slots use exact names. Ignore ambiguous names and slots
+// rather than assigning one player's rating to another army.
+function uniqueScoreboardPlayers(players) {
+    const slots = new Map(), names = new Map();
+    for (const p of players) {
+        if (p.ai || p.observer || !isRecordedSlot(p.startPosition) || !/^[A-Za-z0-9_]{3,24}$/.test(p.name))
+            continue;
+        const name = p.name.toLowerCase();
+        names.set(name, (names.get(name) ?? 0) + 1);
+        slots.set(p.startPosition, slots.has(p.startPosition) ? null : p);
+    }
+    return [...slots.values()].filter(p => p && names.get(p.name.toLowerCase()) === 1);
+}
+
+module.exports = { playerDisplayFields, uniqueScoreboardPlayers };
