+        source = source.replace("local " + name + " = import('/lua/sim/" + file + ".lua')",
+            "local " + name + " = setmetatable({}, {__index=getfenv(1)})\ndoscript('/lua/sim/" + file + ".lua', " + name + ")");
+    }
+    return source === bytes.toString('utf8') ? bytes : Buffer.from(source);
+}
